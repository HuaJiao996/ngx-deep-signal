{
  "name": "ngx-deep-signal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "ng build ngx-deep-signal",
    "start": "ng serve demo",
    "build": "ng build ngx-deep-signal",
    "build:demo": "ng build ngx-deep-signal && ng build demo",
    "watch": "ng build --watch --configuration development",
    "test": "ng test ngx-deep-signal",
    "test:coverage": "ng test ngx-deep-signal --configuration=coverage",
    "e2e": "ng build ngx-deep-signal && ng e2e demo",
    "e2e:ui": "ng build ngx-deep-signal && ng e2e demo -- --ui"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "playwright-ng-schematics": "^21.0.10",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
